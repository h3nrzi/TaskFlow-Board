{
  "name": "taskflow",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "10.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @taskflow/web dev",
    "dev:api": "pnpm --filter @taskflow/api dev",
    "preview": "pnpm --filter @taskflow/web preview",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @taskflow/api test && pnpm test:workflows",
    "verify:frontend": "pnpm test:frontend",
    "check": "pnpm verify:frontend && pnpm verify:dependencies && pnpm typecheck && pnpm build && pnpm test",
    "verify:dependencies": "node tooling/audit-dependencies.mjs",
    "test:workflows": "node --test tooling/workflows.test.mjs",
    "test:frontend": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
